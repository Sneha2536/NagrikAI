# Copy this file to ".env" (same folder) and fill in your keys. NEVER commit .env.

# ---- AI provider: "gemini" (free tier, get a key at https://aistudio.google.com/apikey)
#      or "anthropic" (Claude, key at https://console.anthropic.com)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: a second model to try when the first is overloaded (503) or too slow.
# Copy an exact model name from Google AI Studio. Leave blank to skip.
GEMINI_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Government sources
# PIB works with no key. Change the URL if PIB moves its RSS feed.
PIB_RSS_URL=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3
# Optional: a PEM file with an extra trusted certificate authority, only if a .gov.in
# document fails with a certificate error even after `pip install -r requirements.txt`.
PDF_CA_BUNDLE=
# myScheme needs a key (see README "Data sources"). Leave blank to skip that source.
MYSCHEME_API_KEY=

# ---- Optional
MAX_CONTEXT_CHARS=120000
CORS_ORIGINS=http://localhost:5173
